# Vite base path when the app itself is hosted under a subpath.
# This is not the media CDN. Leave unset for a site served at the domain root.
# ATLAS_BASE=/words/

# Absolute URL of the directory that contains atlas index.json
# (entries/, img/, thumb/, and audio/ live next to it).
# Trailing slash optional. The value must not include index.json itself.
#
# Unset: the app loads same-origin {BASE_URL}atlas/..., npm run dev uses public/atlas,
# and the production build copies that folder into dist/.
# Set: JSON, images, and audio load from this URL, and dist/atlas is omitted.
#
# Example after `rclone copy public/atlas r2:word-atlas/atlas`:
# VITE_ATLAS_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev/atlas
